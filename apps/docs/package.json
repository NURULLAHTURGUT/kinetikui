{
  "name": "@kinetik/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx ../../scripts/build-docs.ts",
    "dev": "next dev --webpack -p 3100",
    "prebuild": "tsx ../../scripts/build-docs.ts",
    "build": "next build --webpack",
    "start": "next start -p 3100",
    "typecheck": "tsx ../../scripts/build-docs.ts && next typegen --webpack && tsc --noEmit"
  },
  "dependencies": {
    "@kinetik/registry": "workspace:*",
    "marked": "^18.1.0",
    "next": "16.4.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-web": "^0.21.4",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
