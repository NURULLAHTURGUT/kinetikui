{
  "name": "kinetik-ui",
  "version": "1.4.2",
  "mcpName": "io.github.NURULLAHTURGUT/kinetik-ui",
  "description": "Add Kinetik UI motion components to an Expo project: copies the source, installs SDK-compatible dependencies, and serves the registry to AI agents over MCP.",
  "license": "MIT",
  "homepage": "https://kinetik-ui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NURULLAHTURGUT/kinetikui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/NURULLAHTURGUT/kinetikui/issues"
  },
  "bin": {
    "kinetik-ui": "dist/index.js",
    "kinetik": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "expo",
    "react-native",
    "reanimated",
    "skia",
    "animation",
    "components",
    "shadcn",
    "registry",
    "mcp",
    "ai"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kinetik/mcp": "workspace:*",
    "@types/node": "^22.15.0",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
